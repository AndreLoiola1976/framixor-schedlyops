# SchedlyOps — runtime configuration
# In Lovable these values must be configured through Workspace Settings → Build Secrets.
# Do not commit real credentials to the repo.

# Supabase is the default development path.
# Mock mode exists only for isolated UI development and testing.
VITE_DATA_SOURCE=supabase

# Required when VITE_DATA_SOURCE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Pilot tenant slug — compared against operator_current_tenant().slug as a guard.
VITE_SCHEDLYOPS_TENANT_SLUG=demo-barber

# Public booking base URL — REQUIRED before Founder Beta / any real customer sharing.
#
# Used by src/lib/public-booking-url.ts to build the URL behind Settings "Copy link",
# TopBar "Open", and Launch Kit share snippets (Instagram / WhatsApp / Google Business).
#
# If unset, the app falls back to window.location.origin. That fallback is dev-only:
# in Lovable preview/editor environments it produces Lovable-gated URLs that prompt a
# Lovable login for logged-out visitors, breaking shared links.
#
# Do NOT default this to a preview/editor/GUID host. Set it in Workspace Settings →
# Build Secrets to a verified public production host, e.g.:
#   https://schedlyops.com
#   https://app.schedlyops.com
#   https://booking.schedlyops.com
#   (or a verified public Lovable/Vercel production host)
# VITE_PUBLIC_BOOKING_BASE_URL=
